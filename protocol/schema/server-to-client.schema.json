{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antigravity-deck.local/schema/server-to-client.schema.json",
  "title": "Antigravity Deck サーバーからクライアントへのメッセージ",
  "description": "PC側のAntigravity拡張機能からAndroidコンパニオンアプリへ配信する単一エージェント状態同期メッセージのJSON Schema定義",
  "oneOf": [
    {
      "$ref": "#/$defs/stateSyncMessage"
    },
    {
      "$ref": "#/$defs/authAckMessage"
    }
  ],
  "$defs": {
    "agentStatus": {
      "type": "string",
      "enum": [
        "idle",
        "thinking",
        "waiting_approval",
        "done",
        "error"
      ],
      "description": "エージェントの実行状態"
    },
    "reasoningEffort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh"
      ],
      "description": "推論の深さ設定"
    },
    "stateSyncMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "timestamp",
        "title",
        "status",
        "approval_preview",
        "reasoning_effort",
        "model_name"
      ],
      "properties": {
        "type": {
          "const": "state_sync"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "title": {
          "type": "string",
          "description": "タスク名や会話のタイトル"
        },
        "status": {
          "$ref": "#/$defs/agentStatus"
        },
        "approval_preview": {
          "type": [
            "string",
            "null"
          ],
          "description": "承認待ちのコマンドやファイル差分の要約テキスト"
        },
        "last_response": {
          "type": [
            "string",
            "null"
          ],
          "description": "エージェントの最新返答テキスト"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conversationMessage"
          },
          "description": "ユーザーとエージェントの会話履歴一覧"
        },
        "conversation_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "現在表示中の会話セッションID"
        },
        "conversations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conversationSummary"
          },
          "description": "切り替え可能な会話セッション概要一覧"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactDocument"
          },
          "description": "選択中セッションで生成されたMarkdownアーティファクト一覧"
        },
        "reasoning_effort": {
          "$ref": "#/$defs/reasoningEffort"
        },
        "model_name": {
          "type": "string",
          "description": "現在使用中のAIモデル識別子"
        },
        "available_models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "クライアント側で選択可能なAIモデル一覧"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "最終更新のISO 8601時刻"
        }
      }
    },
    "conversationMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "content"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "user",
            "assistant"
          ]
        },
        "content": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "conversationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "message_count": {
          "type": "integer",
          "minimum": 0
        },
        "artifact_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "artifactDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "content"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "authAckMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "authenticated"
      ],
      "properties": {
        "type": {
          "const": "auth_ack"
        },
        "authenticated": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
